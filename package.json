{
  "name": "autoapply-mcp",
  "version": "0.1.0",
  "description": "An MCP server that discovers, gates, ranks, tailors and submits job applications from a structured candidate profile - with hard safety gates and a human approval boundary.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jobs",
    "job-search",
    "ats",
    "greenhouse",
    "lever",
    "ashby",
    "automation"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "autoapply-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "presets",
    "examples",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "doctor": "node dist/cli/doctor.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "playwright": "^1.62.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  }
}
